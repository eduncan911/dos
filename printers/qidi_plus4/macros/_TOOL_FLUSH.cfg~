  M117 Flush tooling

  ; initial purge
  ; 
  M83
  G1 E1 F50
  G1 E58.13 F611
  G1 E0.97 F50
  G1 E8.73 F611
  G1 E0.97 F50
  G1 E8.73 F611
  G1 E0.97 F50
  G1 E-2 F1800
  M106 S255
  M400
  G91
  G1 X-3 F60
  G1 X3 F60
  G90
  CLEAR_FLUSH
  
  ; purge the rest and knock off 
  ; the remaining when exiting.
  ; 
  M106 S128
  M83
  G1 E44.8 F611
  G1 E1.2 F50
  G1 E10.8 F611
  G1 E1.2 F50
  G1 E10.8 F611
  G1 E1.2 F50
  G1 E-2 F1800
  M106 S0
  
