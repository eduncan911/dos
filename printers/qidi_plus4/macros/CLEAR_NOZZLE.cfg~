; CLEAR_NOZZLE has been refactored to a "don't bend my nozzle" state,
; along with faster overall performance, and plugging the nozzle on 
; cool-down and heat-up.  Though, you should still use a purge line
; for optimum nozzle pressure on first g-code extrudes.
; 
; It also fixes a bug of the nozzle hitting the purge bucket
; and making a clunking sound.  I think this is what may have been
; bending people's nozzles.
; 
[gcode_macro CLEAR_NOZZLE]
description: CLEAR_NOZZLE is a QIDI default macro that is called.
gcode:
    {% set purge = params.PURGE|default(1)|int %}
    {% set cooldown = params.COOLDOWN|default(1)|int %}
    {% set hotendtemp = params.HOTEND|default(250)|int %}

    M117 Clearing nozzle

    _TOOL_MOVE_BUCKET
    M117 Wait for 150C nozzle
    M104 S150
    TEMPERATURE_WAIT SENSOR=extruder MINIMUM={150}

    M117 Scrub gunk from nozzle
    _TOOL_SCRUB
    _TOOL_MOVE_BUCKET

    {% if purge > 0 %}
      M117 Wait for hotend temp to purge
      M109 S{hotendtemp}
      _FLUSH_TOOL
    {% endif %}

    {% if cooldown > 0 %}
      M104 S140
      G1 Y318 F9000
      G1 Y322 F600
      G1 Y318 F9000
      G1 Y322 F600
      G1 Y308 F30000
      G1 Y324 F600
  
      G1 X124 E-1 F1000 

      {% if printer.extruder.temperature > 150 %}
        M117 Wait for hotend cooldown to 150
        TEMPERATURE_WAIT SENSOR=extruder MAXIMUM={150}
      {% endif %}

      G1 X133 F200
      G1 Y321 F200
      G2 I0.5 J0.5 F600
      G2 I0.5 J0.5 F600
      G2 I0.5 J0.5 F600
  
      G1 Y319 F150
      G1 X132 
      G1 Y324
      G1 X131 
      G1 Y319
      G1 X130
      G1 Y324
      G1 X129
      G1 Y319
  
      G1 X113 F200
      G1 Y320
      G1 X125
      G1 X113
      G1 X125
      G2 I0.5 J0.5 F200
      G2 I0.5 J0.5 F200
      G2 I0.5 J0.5 F200
  
      _TOOL_MOVE_BUCKET
    {% endif %}

    ; plug the extruder and prime (detract)
    M117 Plug and detract extruder
    G0 Y324 F600
    G0 X93 F600
    G0 Y324 F600
    G1 X{ 123 + (range(-7, 7) | random) / 10 } Y{ 321 + (range(-4, 4) | random) / 10 } F600
    M83
    G92 E0
    {% if printer.extruder.can_extrude %}
      M117 Detracting with plugged nozzle.
      G1 E3.0 F200
    {% else %}
      M117 Hotend { printer.extruder.temperature | int } not at temp, skipping detraction
    {% endif %}

    G92 E0
    M106 P0 S0

